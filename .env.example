# Local runtime settings. Keep real secrets here, not in application.yml.

OPENAI_API_KEY=<API_KEY>

DAB_MCP_BASE_URL=http://localhost:5001
ECOM_MSSQL_CONNECTION_STRING=Server=127.0.0.1,1433;Database=EcommercePocDb;User Id=<user>;Password=<password>;TrustServerCertificate=True;Encrypt=True

TOKEN_SECRET_KEY=local-dev-secret-change-me

SPRING_PROFILES_ACTIVE=local
APP_LOG_SENSITIVE_DATA=true

# Derived from ECOM_MSSQL_CONNECTION_STRING for read-only schema introspection.
ECOM_JDBC_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=EcommercePocDb;encrypt=true;trustServerCertificate=true
ECOM_JDBC_USERNAME=<user>
ECOM_JDBC_PASSWORD=<password>

APP_REQUEST_TIMEOUT=30s
APP_PRIMARY_RETRY_ENABLED=false
APP_RESPONSE_FORMAT=prompt_json

app.ai.trace.enabled=true
app.ai.trace.include-sensitive-values=true
app.ai.trace.max-payload-chars=20000
