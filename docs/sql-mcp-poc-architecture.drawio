        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Chat API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569&quot;&gt;Validates requests, returns results&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#0f172a;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="runtime" value="&lt;b&gt;Spring Boot AI Application / Agent Runtime&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#3f7f46&quot;&gt;— single coordinator, not multi-agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fff9;strokeColor=#2e7d32;dashed=1;dashPattern=8 5;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#1b5e20;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="245" y="320" width="760" height="520" as="geometry" />
        </mxCell>

        <mxCell id="coord" value="&lt;b&gt;Request Coordinator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#33691e&quot;&gt;Orchestrates one chat turn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontColor=#0f172a;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="285" y="360" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="prompt" value="&lt;b&gt;System Instructions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#33691e&quot;&gt;Business rules for the assistant&lt;br&gt;Read-only · schema-grounded · injection-resistant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontColor=#0f172a;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="285" y="460" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="runner" value="&lt;b&gt;Model Execution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#33691e&quot;&gt;Primary / fallback model policy&lt;br&gt;Maps output to response contract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontColor=#0f172a;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="285" y="580" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;AI Integration Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#33691e&quot;&gt;Connects the model and approved tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontColor=#0f172a;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="285" y="710" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="memory" value="&lt;b&gt;Sanitized Conversation Memory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#8a5100&quot;&gt;Bounded, protected follow-up context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontColor=#0f172a;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
