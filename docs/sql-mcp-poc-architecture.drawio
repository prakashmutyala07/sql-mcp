        <mxCell id="title" value="Read-only SQL MCP AI Assistant — POC Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="16" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Single-coordinator Spring Boot runtime  ·  LLM never touches the database  ·  Read-only access mediated by Microsoft Data API Builder" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="54" width="1100" height="24" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;Business User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569&quot;&gt;Asks questions in natural language&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#0f172a;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
