        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;User Interface&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569&quot;&gt;Chat UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#0f172a;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Authentication / OIDC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Future production capability&lt;br&gt;Not in current POC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#616161;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
