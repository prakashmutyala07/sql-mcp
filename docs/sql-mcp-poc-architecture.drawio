  <diagram id="sql-mcp-poc-architecture" name="SQL MCP POC Architecture">
    <mxGraphModel dx="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1450" math="0" shadow="0" background="#ffffff">
